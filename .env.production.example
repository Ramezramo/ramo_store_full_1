# Ramo Store — production environment template
# Copy this file to the deployment secret store or server environment. Never commit real secrets.

APP_NAME="Ramo Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
DEBUGBAR_ENABLED=false
APP_URL=https://store.example.com
# Comma-separated CDN/load-balancer IPs or CIDRs only; never use a wildcard.
TRUSTED_PROXIES=
# JSON daily logs with request IDs. Forward this file to centralized log storage and alerting.
LOG_CHANNEL=production
LOG_LEVEL=info
LOG_DAYS=30

# PostgreSQL — use a managed database with TLS, backups, and a separate application user.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Shared state. Redis must be reachable from every PHP application instance and queue worker.
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_COOKIE=ramo_store_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=5
# `predis` is bundled with this project. Prefer `phpredis` only when the PHP extension is installed on every app and worker host.
REDIS_CLIENT=predis
REDIS_URL=
REDIS_HOST=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Files should live in object storage or on a shared persistent volume, not on one application container.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
IMAGE_BASE_URL=

# Email — select a production delivery service and use credentials from the secret manager.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAILTRAP_API_TOKEN=

# OTP SMS — use a real provider in production. Keep `log` only in local development, where the code is deliberately shown in the UI.
SMS_GATEWAY=msegat
SMS_TIMEOUT_SECONDS=10
MSEGAT_USERNAME=
MSEGAT_PASSWORD=
MSEGAT_SENDER=RamoStore
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_FROM=RamoStore

# Set this to the exact public domains that may make stateful requests.
SANCTUM_STATEFUL_DOMAINS=store.example.com

# Run after setting the variables on each release:
# php artisan optimize:clear
# php artisan config:cache
# php artisan route:cache
# php artisan view:cache
# php artisan queue:restart
